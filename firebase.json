{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "public": ".",
    "predeploy": [
      "npm run build:admin"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "docs/**",
      "scripts/**",
      "database.rules.json",
      "functions/**",
      "package.json",
      "package-lock.json",
      "playlist.json",
      "test.html",
      "testmen.html",
      "vite.config.js",
      "web/admin-src/**",
      "*.pptx"
    ],
    "rewrites": [
      {
        "source": "/v1",
        "destination": "/index.html"
      },
      {
        "source": "/v2",
        "destination": "/index-v2.html"
      },
      {
        "source": "/v3",
        "destination": "/index.html"
      },
      {
        "source": "/participant-v1",
        "destination": "/web/participant-flow.html"
      },
      {
        "source": "/participant-v1-sparkle",
        "destination": "/web/participant-flow-sparkle.html"
      },
      {
        "source": "/participant-v2",
        "destination": "/web/participant-flow-v2.html"
      },
      {
        "source": "/participant-v3",
        "destination": "/web/participant-flow.html"
      },
      {
        "source": "/participant-v1-horizontal",
        "destination": "/web/participant-flow-horizontal.html"
      },
      {
        "source": "/participant-v2-horizontal",
        "destination": "/web/participant-flow-v2-horizontal.html"
      },
      {
        "source": "/admin",
        "destination": "/web/admin-dist/index.html"
      }
    ]
  }
}
