{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "docs/**",
      "scripts/**",
      "database.rules.json",
      "playlist.json",
      "*.pptx"
    ],
    "rewrites": [
      {
        "source": "/v1",
        "destination": "/index.html"
      },
      {
        "source": "/v2",
        "destination": "/index-v2.html"
      },
      {
        "source": "/participant-v1",
        "destination": "/web/participant-flow.html"
      },
      {
        "source": "/participant-v2",
        "destination": "/web/participant-flow-v2.html"
      }
    ]
  }
}
