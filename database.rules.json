{
  "rules": {
    ".read": false,
    ".write": false,
    "participation": {
      ".read": true,
      ".write": "auth != null",
      "participantCount": {
        ".write": "(!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "lastCelebratedCount": {
        ".write": "auth != null || !data.exists() || (data.isNumber() && newData.isNumber() && newData.val() >= data.val())",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['type', 'createdAt']) && newData.child('type').val() === 'swipe-completed'"
        }
      },
      "dailyParticipants": {
        "$date": {
          "$visitorId": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 1"
          }
        }
      },
      "participantHistory": {
        "$visitorId": {
          ".write": true,
          ".validate": "newData.hasChildren(['lastParticipationDate', 'streakDays']) && newData.child('lastParticipationDate').isString() && newData.child('streakDays').isNumber() && newData.child('streakDays').val() >= 1"
        }
      },
      "$other": {
        ".validate": false
      }
    },
