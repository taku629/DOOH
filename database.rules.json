{
  "rules": {
    ".read": false,
    ".write": false,
    "participation": {
      ".write": false,
      "participantCount": {
        ".read": true,
        ".write": false
      },
      "swipes": {
        ".read": true,
        ".write": false,
        ".indexOn": ["createdAt"]
      },
      "counterShards": {
        ".read": false,
        ".write": false
      },
      "eventIds": {
        ".read": false,
        ".write": false
      }
    },
    "participationV2": {
      ".write": false,
      "participantCount": {
        ".read": true,
        ".write": false
      },
      "swipes": {
        ".read": true,
        ".write": false,
        ".indexOn": ["createdAt"]
      },
      "counterShards": {
        ".read": false,
        ".write": false
      },
      "eventIds": {
        ".read": false,
        ".write": false
      }
    },
    "participationMorning": {
      ".write": false,
      "participantCount": {
        ".read": true,
        ".write": false
      },
      "swipes": {
        ".read": true,
        ".write": false,
        ".indexOn": ["createdAt"]
      },
      "counterShards": {
        ".read": false,
        ".write": false
      },
      "eventIds": {
        ".read": false,
        ".write": false
      }
    },
    "nameShouts": {
      "$channel": {
        ".read": true,
        "$eventId": {
          ".write": "!data.exists() && ($channel === 'default' || $channel === 'v2' || $channel === 'morning')",
          ".validate": "newData.hasChildren(['type', 'createdAt']) && newData.child('type').val() === 'name-announced' && (!newData.child('name').exists() || newData.child('name').val() === null || (newData.child('name').isString() && newData.child('name').val().length <= 24))",
          "$other": {
            ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
          }
        }
      }
    },
    "displayConfig": {
      "$channel": {
        ".read": "$channel === 'default' || $channel === 'v2' || $channel === 'morning'",
        ".write": false
      }
    }
  }
}
