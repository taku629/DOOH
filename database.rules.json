{
  "rules": {
    ".read": false,
    ".write": false,
    "participation": {
      ".write": false,
      "participantCount": {
        ".read": true,
        ".write": false
      },
      "swipes": {
        ".read": true,
        ".write": false,
        ".indexOn": ["createdAt"]
      },
      "counterShards": {
        ".read": false,
        ".write": false
      },
      "eventIds": {
        ".read": false,
        ".write": false
      }
    },
    "participationV2": {
      ".write": false,
      "participantCount": {
        ".read": true,
        ".write": false
      },
      "swipes": {
        ".read": true,
        ".write": false,
        ".indexOn": ["createdAt"]
      },
      "counterShards": {
        ".read": false,
        ".write": false
      },
      "eventIds": {
        ".read": false,
        ".write": false
      }
    },
    "participationMorning": {
      ".write": false,
      "participantCount": {
        ".read": true,
        ".write": false
      },
      "swipes": {
        ".read": true,
        ".write": false,
        ".indexOn": ["createdAt"]
      },
      "counterShards": {
        ".read": false,
        ".write": false
      },
      "eventIds": {
        ".read": false,
        ".write": false
      }
    },
    "displayConfig": {
      "$channel": {
        ".read": "$channel === 'default' || $channel === 'v2' || $channel === 'morning'",
        ".write": false
      }
    }
  }
}
