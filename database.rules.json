{
  "rules": {
    ".read": false,
    ".write": false,
    "participation": {
      ".read": true,
      ".write": "auth != null || (newData.child('participantCount').isNumber() && newData.child('participantCount').val() === (data.child('participantCount').exists() ? data.child('participantCount').val() + 1 : 1))",
      "participantCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".validate": "data.exists() || (newData.hasChildren(['type', 'createdAt', 'count']) && newData.child('type').val() === 'swipe-completed' && newData.child('count').isNumber() && newData.child('count').val() === newData.parent().parent().child('participantCount').val())"
        }
      },
      "dailyParticipants": {
        "$date": {
          "$visitorId": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          }
        }
      },
      "participantHistory": {
        "$visitorId": {
          ".validate": "newData.hasChildren(['lastParticipationDate', 'streakDays']) && newData.child('lastParticipationDate').isString() && newData.child('streakDays').isNumber() && newData.child('streakDays').val() >= 1"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "participationV2": {
      ".read": true,
      ".write": "auth != null || (newData.child('participantCount').isNumber() && newData.child('participantCount').val() === (data.child('participantCount').exists() ? data.child('participantCount').val() + 1 : 1))",
      "participantCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".validate": "data.exists() || (newData.hasChildren(['type', 'createdAt', 'count']) && newData.child('type').val() === 'swipe-completed' && newData.child('count').isNumber() && newData.child('count').val() === newData.parent().parent().child('participantCount').val())"
        }
      },
      "dailyParticipants": {
        "$date": {
          "$visitorId": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          }
        }
      },
      "participantHistory": {
        "$visitorId": {
          ".validate": "newData.hasChildren(['lastParticipationDate', 'streakDays']) && newData.child('lastParticipationDate').isString() && newData.child('streakDays').isNumber() && newData.child('streakDays').val() >= 1"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "participationMorning": {
      ".read": true,
      ".write": "auth != null || (newData.child('participantCount').isNumber() && newData.child('participantCount').val() === (data.child('participantCount').exists() ? data.child('participantCount').val() + 1 : 1))",
      "participantCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".validate": "data.exists() || (newData.hasChildren(['type', 'createdAt', 'count']) && newData.child('type').val() === 'swipe-completed' && newData.child('count').isNumber() && newData.child('count').val() === newData.parent().parent().child('participantCount').val())"
        }
      },
      "dailyParticipants": {
        "$date": {
          "$visitorId": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          }
        }
      },
      "participantHistory": {
        "$visitorId": {
          ".validate": "newData.hasChildren(['lastParticipationDate', 'streakDays']) && newData.child('lastParticipationDate').isString() && newData.child('streakDays').isNumber() && newData.child('streakDays').val() >= 1"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "participationResearch": {
      ".read": true,
      ".write": "auth != null || (newData.child('participantCount').isNumber() && newData.child('participantCount').val() === (data.child('participantCount').exists() ? data.child('participantCount').val() + 1 : 1))",
      "participantCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".validate": "data.exists() || (newData.hasChildren(['type', 'createdAt', 'count']) && newData.child('type').val() === 'swipe-completed' && newData.child('count').isNumber() && newData.child('count').val() === newData.parent().parent().child('participantCount').val())"
        }
      },
      "dailyParticipants": {
        "$date": {
          "$visitorId": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          }
        }
      },
      "participantHistory": {
        "$visitorId": {
          ".validate": "newData.hasChildren(['lastParticipationDate', 'streakDays']) && newData.child('lastParticipationDate').isString() && newData.child('streakDays').isNumber() && newData.child('streakDays').val() >= 1"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "nameShouts": {
      "$channel": {
        ".read": true,
        "$eventId": {
          ".write": "!data.exists() && ($channel === 'default' || $channel === 'v2' || $channel === 'morning' || $channel === 'research')",
          ".validate": "newData.hasChildren(['type', 'createdAt']) && newData.child('type').val() === 'name-announced' && (!newData.child('name').exists() || newData.child('name').val() === null || (newData.child('name').isString() && newData.child('name').val().length <= 24))",
          "$other": {
            ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
          }
        }
      }
    },
    "displayConfig": {
      "$channel": {
        ".read": true,
        ".write": "auth != null && ($channel === 'default' || $channel === 'v2' || $channel === 'morning')"
      }
    }
  }
}
