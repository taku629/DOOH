{
  "rules": {
    ".read": false,
    ".write": false,
    "participation": {
      ".read": true,
      ".write": "auth != null || (newData.child('participantCount').isNumber() && newData.child('participantCount').val() === (data.child('participantCount').exists() ? data.child('participantCount').val() + 1 : 1))",
      "participantCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".validate": "data.exists() || (newData.hasChildren(['type', 'createdAt', 'count']) && newData.child('type').val() === 'swipe-completed' && newData.child('count').isNumber() && newData.child('count').val() === newData.parent().parent().child('participantCount').val())"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "participationV2": {
      ".read": true,
      ".write": "auth != null || (newData.child('participantCount').isNumber() && newData.child('participantCount').val() === (data.child('participantCount').exists() ? data.child('participantCount').val() + 1 : 1))",
      "participantCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".validate": "data.exists() || (newData.hasChildren(['type', 'createdAt', 'count']) && newData.child('type').val() === 'swipe-completed' && newData.child('count').isNumber() && newData.child('count').val() === newData.parent().parent().child('participantCount').val())"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "participationMorning": {
      ".read": true,
      ".write": "auth != null || (newData.child('participantCount').isNumber() && newData.child('participantCount').val() === (data.child('participantCount').exists() ? data.child('participantCount').val() + 1 : 1))",
      "participantCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "swipes": {
        "$eventId": {
          ".validate": "data.exists() || (newData.hasChildren(['type', 'createdAt', 'count']) && newData.child('type').val() === 'swipe-completed' && newData.child('count').isNumber() && newData.child('count').val() === newData.parent().parent().child('participantCount').val())"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "displayConfig": {
      "$channel": {
        ".read": true,
        ".write": "auth != null && ($channel === 'default' || $channel === 'v2' || $channel === 'morning')"
      }
    }
  }
}
