    },
    "nameShouts": {
      "$channel": {
        ".read": true,
        ".indexOn": ["visitorId"],
        "$eventId": {
          ".write": "!data.exists() && ($channel === 'default' || $channel === 'v2' || $channel === 'morning' || $channel === 'research')",
          ".validate": "newData.hasChildren(['type', 'createdAt']) && newData.child('type').val() === 'name-announced' && (!newData.child('name').exists() || newData.child('name').val() === null || (newData.child('name').isString() && newData.child('name').val().length <= 24))",
          "$other": {
            ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
          }
        }
      }
    },
    "supporterComments": {
      "$channel": {
        ".read": true,
        "$commentId": {
          ".write": "!data.exists() && ($channel === 'default' || $channel === 'v2' || $channel === 'morning' || $channel === 'research')",
          ".validate": "newData.hasChildren(['type', 'createdAt', 'codeHash', 'comment']) && newData.child('type').val() === 'supporter-comment' && newData.child('codeHash').isString() && newData.child('codeHash').val().length === 64 && newData.child('comment').isString() && newData.child('comment').val().length > 0 && newData.child('comment').val().length <= 60 && (!newData.child('name').exists() || newData.child('name').val() === null || (newData.child('name').isString() && newData.child('name').val().length <= 24))",
          "$other": {
            ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.val() === null"
          }
        }
      }
    },
    "displayConfig": {
      "$channel": {
        ".read": true,
        ".write": "auth != null && ($channel === 'default' || $channel === 'v2' || $channel === 'morning')"
      }
    }
  }
}
