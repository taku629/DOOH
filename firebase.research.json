{
  "hosting": {
    "site": "shinjuku-dooh-rs",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.research.json",
      "index.html",
      "**/.*",
      ".git",
      ".git/**",
      "**/.git/**",
      "**/node_modules/**",
      "README.md",
      "docs/**",
      "shinjuku-dooh-demo/**",
      "scripts/**",
      "database.rules.json",
      "package.json",
      "package-lock.json",
      "playlist.json",
      "test.html",
      "testmen.html",
      "vite.config.js",
      "web/admin-src/**",
      "*.pptx",
      "firebase-rs.json",
      "**/*.py",
      "**/__pycache__/**",
      "**/*.log",
      "**/*.save",
      "artifacts/**",
      "rs-public/**",
      "thanks-proto.html"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/research-preview.html"
      },
      {
        "source": "/research",
        "destination": "/research-preview.html"
      },
      {
        "source": "/team-test",
        "destination": "/research-preview.html"
      },
      {
        "source": "/demo",
        "destination": "/demo.html"
      },
      {
        "source": "/men",
        "destination": "/web/participant-flow-shared.html"
      },
      {
        "source": "/women",
        "destination": "/web/participant-flow-shared.html"
      }
    ]
  }
}
